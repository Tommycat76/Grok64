diff --git a/libretro/libretro-core.c b/libretro/libretro-core.c
index cfd5b89..433f783 100644
--- a/libretro/libretro-core.c
+++ b/libretro/libretro-core.c
@@ -1410,6 +1410,13 @@ void autodetect_drivetype(int unit)
          log_cb(RETRO_LOG_ERROR, "Failed to get disk image for unit %d.\n", unit);
       else
       {
+         /* Grok64: a configured 1541 keeps 1541-format images, since any type set resets the drive CPU */
+         if (drive_type == DRIVE_TYPE_1541
+               && (diskimg->type == DISK_IMAGE_TYPE_D64
+                  || diskimg->type == DISK_IMAGE_TYPE_G64
+                  || diskimg->type == DISK_IMAGE_TYPE_P64))
+            return;
+
          /* G64/G71 exceptions for preventing unwanted drive type sets */
          if (diskimg->type == DISK_IMAGE_TYPE_G64)
             set_drive_type = DRIVE_TYPE_1541II;
@@ -1596,9 +1603,14 @@ void update_work_disk(void)
       {
          if (string_is_empty(full_path) || (!string_is_empty(full_path) && !strstr(full_path, work_disk_filename)))
          {
+            int drive8_type = 0;
+
             log_cb(RETRO_LOG_INFO, "Work disk \"%s\" detached from drive #%d.\n", attached_image, 8);
             file_system_detach_disk(8, 0);
-            log_resources_set_int("Drive8Type", DRIVE_TYPE_DEFAULT);
+            /* Grok64: a 1541 or 1541-II stays as is; re-setting the type resets the drive CPU */
+            resources_get_int("Drive8Type", &drive8_type);
+            if (drive8_type != DRIVE_TYPE_1541 && drive8_type != DRIVE_TYPE_1541II)
+               log_resources_set_int("Drive8Type", DRIVE_TYPE_DEFAULT);
             if (string_is_empty(full_path))
                display_current_image("", false);
          }
diff --git a/retrodep/ui.c b/retrodep/ui.c
index 1241a38..ca446b7 100644
--- a/retrodep/ui.c
+++ b/retrodep/ui.c
@@ -282,6 +282,8 @@ int ui_init_finalize(void)
 
       snprintf(tmp_str, sizeof(tmp_str), "%s%c%s", retro_system_data_directory, ARCHDEP_DIR_SEP_CHR, "JiffyDOS_1541-II.bin");
       log_resources_set_string("DosName1541ii", (const char*)tmp_str);
+      /* Grok64: VICE emulates 1541 and 1541-II alike, so a 1541 drive runs the same JiffyDOS ROM */
+      log_resources_set_string("DosName1541", (const char*)tmp_str);
       snprintf(tmp_str, sizeof(tmp_str), "%s%c%s", retro_system_data_directory, ARCHDEP_DIR_SEP_CHR, "JiffyDOS_1571_repl310654.bin");
       log_resources_set_string("DosName1571", (const char*)tmp_str);
       snprintf(tmp_str, sizeof(tmp_str), "%s%c%s", retro_system_data_directory, ARCHDEP_DIR_SEP_CHR, "JiffyDOS_1581.bin");
@@ -319,6 +321,7 @@ int ui_init_finalize(void)
       resources_get_int("Drive8Type", &drive_type);
 
       log_resources_set_string("DosName1541ii", DRIVE_ROM1541II_NAME);
+      log_resources_set_string("DosName1541", DRIVE_ROM1541_NAME);
       log_resources_set_string("DosName1571", DRIVE_ROM1571_NAME);
       log_resources_set_string("DosName1581", DRIVE_ROM1581_NAME);
 #if defined(__X64__) || defined(__X64SC__)
